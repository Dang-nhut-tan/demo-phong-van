extends ../layouts/default.pug

block main
  h1.box-title Quản lý người dùng

  //- Section 4
  .section-4
    .inner-wrap
      .inner-item.inner-label
        <i class="fa-solid fa-filter"></i> Bộ lọc
      .inner-item
        select(filter-status)
          option(value="") Trạng thái
          option(value="active" selected=(currentStatus == "active")) Hoạt động
          option(value="inactive" selected=(currentStatus == "inactive")) Tạm dừng
      .inner-item.inner-date
        input(type="date" filter-start-date)
        span -
        input(type="date" filter-end-date)
      .inner-item.inner-reset(filter-reset)
        <i class="fa-solid fa-rotate-left"></i> Xóa bộ lọc
  //- End Section 4

  //- Section 5
  .section-5
    .inner-wrap
      .inner-change-status(
        change-multi
        data-api=`/${pathAdmin}/user/change-multi`
      )
        .inner-item
          select
            option(value="") -- Hành động --
            option(value="active") Hoạt động
            option(value="inactive") Dừng hoạt động
            option(value="delete") Xóa
        .inner-item
          button Áp dụng
      .inner-search
        <i class="fa-solid fa-magnifying-glass"></i>
        input(type="text" placeholder="Tìm kiếm theo tên, email, SĐT" search value=keyword)
  //- End Section 5

  //- Section 6
  .section-6
    .table-2
      table
        thead
          tr
            th(class="inner-center")
              input(type="checkbox" class="inner-check" check-all)
            th Họ tên
            th(class="inner-center") Ảnh đại diện
            th Email
            th Số điện thoại
            th Địa chỉ
            th Trạng thái
            th(class="inner-center") Hành động
        tbody
          if (userList && userList.length > 0)
            each user in userList
              tr
                td(class="inner-center")
                  input(type="checkbox" class="inner-check" check-item=user.id)
                td
                  strong #{user.fullName}
                td(class="inner-center")
                  img(src=(user.avatar || "/admin/assets/images/avatar.jpg") class="inner-avatar" alt=user.fullName)
                td #{user.email}
                td #{user.phone}
                td #{user.address || "-"}
                td
                  if (user.status == "active")
                    .badge.badge-green Hoạt động
                  else
                    .badge.badge-red Tạm dừng
                td(class="inner-center")
                  .inner-buttons
                    button(
                      class="inner-delete"
                      button-delete
                      data-api=`/${pathAdmin}/user/delete/${user.id}`
                      title="Xóa người dùng"
                    ) <i class="fa-regular fa-trash-can"></i>
          else
            tr
              td(colspan="8" style="text-align: center; padding: 24px; color: #64748b;") Không tìm thấy người dùng nào
  //- End Section 6

  //- Section 7
  .section-7
    span(class="inner-label") Hiển thị #{userList ? userList.length : 0} người dùng
  //- End Section 7