doctype html
html(lang="vi")
  head
    meta(charset="UTF-8")
    meta(
      content="width=device-width, initial-scale=1.0" 
      name="viewport"
      )
    title #{pageTitle}
    link(
      href=settingWebsiteInfo.favicon 
      rel="icon" 
      type="image/x-icon"
    )
    link(
      rel="preconnect" 
      href="https://fonts.googleapis.com"
      )
    link(
      rel="preconnect" 
      href="https://fonts.gstatic.com" 
      crossorigin
      )
    link(
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" 
      rel="stylesheet"
      )
    link(
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" 
      rel="stylesheet"
      )
    link(
      rel="stylesheet" 
      href="https://unpkg.com/aos@2.3.1/dist/aos.css"
      )
    link(
      href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" 
      rel="stylesheet"
      )
    link(
      href="https://cdnjs.cloudflare.com/ajax/libs/viewerjs/1.11.7/viewer.min.css" 
      rel="stylesheet"
      )
    link(
      href="/assets/css/style.css" 
      rel="stylesheet"
      )
    link(rel="stylesheet", href="/assets/css/about.css")
  body

    - if (messages.success)
      div(class="alert alert-success" alert-time="3000")
        span #{messages.success}

    include ../partials/header.pug
  
    block main
    
    include ../partials/footer.pug

    include ../partials/box-contact.pug

    script(src="https://unpkg.com/aos@2.3.1/dist/aos.js")
    script(src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js")
    script(src="https://cdnjs.cloudflare.com/ajax/libs/viewerjs/1.11.7/viewer.min.js")
    script(
      src="https://cdn.jsdelivr.net/npm/just-validate@4.3.0/dist/just-validate.production.min.js"
      )
    script(src="/assets/js/script.js")
