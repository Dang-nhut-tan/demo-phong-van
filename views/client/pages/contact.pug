extends ../layouts/default.pug

block main
  .contact-hero
    .container
      .contact-hero-content
        span.contact-eyebrow LIÊN HỆ VỚI CHÚNG TÔI
        h1 VietTravel luôn sẵn sàng lắng nghe bạn
        p Mọi thắc mắc về tour du lịch, đặt dịch vụ hoặc đóng góp ý kiến, vui lòng liên hệ với chúng tôi qua thông tin bên dưới hoặc ghé thăm văn phòng.

  .contact-section
    .container
      .contact-grid
        .contact-info-card
          .contact-card-header
            span.contact-card-pill
              i.fa-solid.fa-headset
              | Kênh hỗ trợ
            h2 Thông tin liên hệ
          .contact-item
            i.fa-solid.fa-location-dot
            div
              strong Địa chỉ trụ sở chính
              p #{settingWebsiteInfo.address || "123 Nguyễn Huệ, Quận 1, TP.HCM"}
          .contact-item
            i.fa-solid.fa-phone
            div
              strong Hotline tư vấn
              p #{settingWebsiteInfo.phone || "1900 8686"}
          .contact-item
            i.fa-solid.fa-envelope
            div
              strong Hòm thư điện tử
              p #{settingWebsiteInfo.email || "hello@viettravel.vn"}
          .contact-item
            i.fa-solid.fa-clock
            div
              strong Giờ làm việc
              p Thứ Hai - Chủ Nhật: 08:00 - 18:00

          form.contact-form#contact-page-form(action="/contact/create" method="POST")
            h3 Để lại thông tin tư vấn
            .contact-form-group
              input(type="email" name="email" placeholder="Email của bạn *" required)
            .contact-form-group
              input(type="text" name="fullName" placeholder="Họ và tên của bạn")
            .contact-form-group
              input(type="text" name="phone" placeholder="Số điện thoại")
            .contact-form-group
              textarea(name="content" rows="3" placeholder="Nội dung cần hỗ trợ hoặc tư vấn tour...")
            button(type="submit") Gửi Yêu Cầu

        .contact-map-card
          .contact-map-header
            .contact-map-meta
              span.contact-card-pill.map-pill
                i.fa-solid.fa-map-location-dot
                | Vị trí văn phòng
              h2 Trụ sở chính VietTravel
              p.contact-map-address
                i.fa-solid.fa-location-dot
                span #{settingWebsiteInfo.address || "123 Nguyễn Huệ, Quận 1, TP.HCM"}
            a.contact-directions-btn(
              href="https://maps.google.com/?q=123+Nguy%E1%BB%85n+Hu%E1%BB%87,+Qu%E1%BA%ADn+1,+TP.HCM" 
              target="_blank" 
              rel="noopener noreferrer"
              title="Mở Google Maps chỉ đường"
            )
              i.fa-solid.fa-diamond-turn-right
              span Chỉ đường
              i.fa-solid.fa-arrow-up-right-from-square

          .contact-map-wrapper
            iframe(
              src="https://maps.google.com/maps?q=123+Nguy%E1%BB%85n+Hu%E1%BB%87,+Qu%E1%BA%ADn+1,+TP.HCM&t=&z=15&ie=UTF8&iwloc=&output=embed"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
            )
            .contact-map-overlay-badge
              i.fa-solid.fa-compass
              span Google Maps tương tác

          .contact-map-features
            .contact-feature-item
              i.fa-solid.fa-square-parking
              span Bãi đỗ xe ô tô & xe máy
            .contact-feature-item
              i.fa-solid.fa-train-subway
              span Tuyến Metro Bến Thành
            .contact-feature-item
              i.fa-solid.fa-bell-concierge
              span Đón tiếp chu đáo tận tâm
