extends layout.pug
block publicContent
  .hr-login
    .hr-login-card
      a.hr-brand(href="/")
        span Viet
        | Travel
        small  HR
      h1 Đăng nhập Nhân sự
      p Quản lý tuyển dụng và hồ sơ ứng viên
      if error
        .hr-error #{error}
      form(method="post",action="/hr/login")
        label Email
        input(type="email",name="email",required,placeholder="Ví dụ: hr@viettravel.vn")
        label Mật khẩu
        input(type="password",name="password",required,placeholder="Nhập mật khẩu")
        button(type="submit") Đăng nhập
