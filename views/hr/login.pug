extends layout.pug
block publicContent
  .hr-login
    .hr-login-card
      .hr-card-header
        a.hr-brand(href="/")
          span Viet
          | Travel
          small  HR Portal
        h1 Đăng nhập Nhân sự
        p Quản lý tuyển dụng, phỏng vấn và hồ sơ ứng viên
      if error
        .hr-error
          i.fa-solid.fa-circle-exclamation
          span #{error}
      form(method="post",action="/hr/login",autocomplete="off")
        .hr-form-group
          label
            i.fa-regular.fa-envelope
            | Email đăng nhập
          input(type="email",name="email",required,placeholder="Nhập email nhân sự",autocomplete="off")
        .hr-form-group
          label
            i.fa-solid.fa-lock
            | Mật khẩu
          input(type="password",name="password",required,placeholder="Nhập mật khẩu",autocomplete="new-password",value="")
        button(type="submit")
          span Đăng nhập
          i.fa-solid.fa-arrow-right
      .hr-footer-links
        a(href="/")
          i.fa-solid.fa-arrow-left
          | Quay lại trang chủ VietTravel
      script.
        window.addEventListener('DOMContentLoaded', () => {
          const pwd = document.querySelector('input[name="password"]');
          if (pwd) {
            pwd.value = '';
            setTimeout(() => { pwd.value = ''; }, 100);
            setTimeout(() => { pwd.value = ''; }, 300);
          }
        });
